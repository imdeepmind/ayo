{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "arrowParens": "always",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/context(/.*)?$",
    "^@/hooks(/.*)?$",
    "",
    "^@/lib(/.*)?$",
    "",
    "^@/components(/.*)?$",
    "",
    "^@/pages(/.*)?$",
    "",
    "^@/theme(/.*)?$",
    "^@/assets(/.*)?$",
    "",
    "^[./]"
  ]
}
